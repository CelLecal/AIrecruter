# 🔹 App
PORT=3001
ENV_NAME=FIRST
# 🔹 Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password
DB_NAME=your_db

# 🔹 TypeORM
TYPEORM_SYNC=true
TYPEORM_LOGGING=true

# 🔹 JWT (если используешь авторизацию)
JWT_SECRET=supersecretkey
JWT_EXPIRES_IN=1d

# 🔹 Docker (фикс имени проекта)
COMPOSE_PROJECT_NAME=my-api